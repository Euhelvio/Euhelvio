# Copie este arquivo para .env.local (nunca commitado) e preencha com a
# connection string do seu banco Postgres.
#
# No Supabase: Project Settings > Database > Connection string > URI
# (use a versão "Transaction pooler" se for rodar em ambiente serverless,
# como a Vercel; a versão direta funciona bem para desenvolvimento local).
#
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/floripa_imoveis_dev
